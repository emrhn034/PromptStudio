{
  "name": "promptstudio",
  "version": "0.7.2",
  "description": "Türkçe YouTube içerik ve kapak stüdyosu",
  "main": "desktop/main.cjs",
  "private": true,
  "author": "PromptStudio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/run-desktop.cjs",
    "check": "node --check desktop/main.cjs && node --check desktop/store.cjs && node --check desktop/services.cjs && node --check ui/app.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.promptstudio.desktop",
    "productName": "PromptStudio",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "ui/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
